                 (nbrMask sMask (us.get i₂ &&& sMask)).testBit w.val
          have he1 : hasEdgeBit ((us.get i₁ &&& sMask) &&& sMask) = false := by
            rw [Nat.and_assoc, Nat.and_self]
            exact h0.trans he
          have he2 : hasEdgeBit ((us.get i₂ &&& sMask) &&& sMask) = false := by
            rw [Nat.and_assoc, Nat.and_self]
            exact he
          rw [nbrMask_eq_pGraph sMask _ hsMask he1 w, nbrMask_eq_pGraph sMask _ hsMask he2 w]
          have hw1 : (fun i => if sMask.testBit i.val = true then ((us.get i₁ &&& sMask) &&& sMask).testBit i.val else decide (i = w)) =
                     (fun j => if j ∈ S then maskFn (us.get i₁ &&& sMask) j else decide (j = w)) := by
            funext j
            simp [sMask, testBit_packFun, maskFn]
          have hw2 : (fun i => if sMask.testBit i.val = true then ((us.get i₂ &&& sMask) &&& sMask).testBit i.val else decide (i = w)) =
                     (fun j => if j ∈ S then maskFn (us.get i₂ &&& sMask) j else decide (j = w)) := by
            funext j
            simp [sMask, testBit_packFun, maskFn]
          rw [hw1, hw2]
          exact hagree (fun j => decide (j = w))
        · have h10k : 2 ^ 10 ≤ 2 ^ k := Nat.pow_le_pow_right (by decide) (by omega)
          have h1 := Nat.testBit_lt_two_pow ((nbrMask_lt sMask (us.get i₁ &&& sMask) hsMask).trans_le h10k)
          have h2 := Nat.testBit_lt_two_pow ((nbrMask_lt sMask (us.get i₂ &&& sMask) hsMask).trans_le h10k)

    have hmap : (us.map (smallSigNat sMask)).get ⟨i₁.val, by simp [i₁.isLt]⟩ =
                (us.map (smallSigNat sMask)).get ⟨i₂.val, by simp [i₂.isLt]⟩ := by
      simpa using hSameSig
    have heqFin := (List.Nodup.get_inj_iff hnodup).mp hmap
    exact Fin.ext (by simpa using congrArg Fin.val heqFin)

def witnessAt (s : ℕ) : ℕ :=
  (witnessChunks.getD (s / 16) []).getD (s % 16) 0

def pGraph (x : Fin 10 → Bool) : Bool :=
  decide (∃ i j : Fin 10, x i = true ∧ x j = true ∧ (pMask.getD i.val 0).testBit j.val = true)

def popcount10 (m : ℕ) : ℕ :=
  (List.finRange 10).countP (fun i => m.testBit i.val)

def hasEdgeBit (m : ℕ) : Bool :=
  (List.finRange 10).any fun i => m.testBit i.val && ((m &&& pMask.getD i.val 0) != 0)

def nbrMask (sMask uMask : ℕ) : ℕ :=
  ((List.finRange 10).foldr (fun i acc =>
    if (uMask &&& sMask).testBit i.val then acc ||| pMask.getD i.val 0 else acc) 0) &&& (1023 ^^^ sMask)

def smallSigNat (sMask uMask : ℕ) : ℕ :=
  let u := uMask &&& sMask
  if hasEdgeBit u then 1024 else nbrMask sMask u

def unpack (m v : ℕ) : List ℕ :=
  match m with
  | 0 => []
  | m + 1 => (v &&& 1023) :: unpack m (v >>> 10)

def strictlyInc : List ℕ → Bool
  | [] => true
  | [_] => true
  | a :: b :: rest => decide (a < b) && strictlyInc (b :: rest)

def checkWith (s v : ℕ) : Bool :=
  let cnt := targetCount.getD (popcount10 s) 0
  let us := unpack cnt v
  strictlyInc (us.map (smallSigNat s))

def checkList (lo : ℕ) (tbl : List ℕ) : Bool :=
  (List.finRange 16).all fun off => checkWith (lo + off.val) (tbl.getD off.val 0)


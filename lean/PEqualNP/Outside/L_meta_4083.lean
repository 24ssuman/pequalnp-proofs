lemma nz_iff_testBit (z : ℕ) (hz : z < 1024) :
    (z != 0) = (List.finRange 10).any fun j : Fin 10 => z.testBit j.val := by
  have hfin : ∀ a : Fin 1024, (a.val != 0) = (List.finRange 10).any fun j : Fin 10 => a.val.testBit j.val := by
    decide +kernel
  exact hfin ⟨z, hz⟩

lemma pMask_symm (i j : Fin 10) :
    (pMask.getD i.val 0).testBit j.val = (pMask.getD j.val 0).testBit i.val := by
  fin_cases i <;> fin_cases j <;> decide

lemma pMask_irrefl (i : Fin 10) : (pMask.getD i.val 0).testBit i.val = false := by
  fin_cases i <;> decide

lemma testBit_1023 (k : ℕ) (hk : k < 10) : (1023 : ℕ).testBit k = true := by
  interval_cases k <;> decide

lemma unpack_length (m v : ℕ) : (unpack m v).length = m := by
  induction m generalizing v with
  | zero => rfl
  | succ m ih => simp [unpack, ih]

lemma strictlyInc_lt : ∀ {a : ℕ} {l : List ℕ}, strictlyInc (a :: l) = true → ∀ x ∈ l, a < x := by
  intro a l
  induction l generalizing a with
  | nil => simp
  | cons b rest ih =>
    intro h x hx
    simp only [strictlyInc, Bool.and_eq_true, decide_eq_true_eq] at h
    rcases List.mem_cons.mp hx with rfl | hx'
    · exact h.1
    · exact lt_trans h.1 (ih h.2 x hx')

lemma strictlyInc_nodup : ∀ {l : List ℕ}, strictlyInc l = true → l.Nodup := by
  intro l
  induction l with
  | nil => intro _; exact List.nodup_nil
  | cons a rest ih =>
    intro h
    have hmem : a ∉ rest := fun ha => lt_irrefl a (strictlyInc_lt h a ha)
    have hsub : strictlyInc rest = true := by
      cases rest with
      | nil => rfl
      | cons b r =>
        simp only [strictlyInc, Bool.and_eq_true] at h
        exact h.2
    exact List.nodup_cons.mpr ⟨hmem, ih hsub⟩

lemma testBit_foldr_lor (p : Fin 10 → Bool) (f : Fin 10 → ℕ) (l : List (Fin 10)) (k : ℕ) :
    (l.foldr (fun i acc => if p i then acc ||| f i else acc) 0).testBit k =
      l.any (fun i => p i && (f i).testBit k) := by
  induction l with
  | nil => simp
  | cons a l ih =>
    simp only [List.foldr_cons, List.any_cons]
    cases p a
    · simp [ih]
    · simp [ih, Bool.or_comm]

def packFun (f : Fin 10 → Bool) : ℕ :=
  (if f 0 then 2^0 else 0) ||| (if f 1 then 2^1 else 0) ||| (if f 2 then 2^2 else 0) |||
  (if f 3 then 2^3 else 0) ||| (if f 4 then 2^4 else 0) ||| (if f 5 then 2^5 else 0) |||
  (if f 6 then 2^6 else 0) ||| (if f 7 then 2^7 else 0) ||| (if f 8 then 2^8 else 0) |||
  (if f 9 then 2^9 else 0)

lemma packFun_lt (f : Fin 10 → Bool) : packFun f < 1024 := by
  have hor {a b : ℕ} (ha : a < 2 ^ 10) (hb : b < 2 ^ 10) : (a ||| b) < 2 ^ 10 :=
    Nat.or_lt_two_pow ha hb
  change packFun f < 2 ^ 10
  refine hor (hor (hor (hor (hor (hor (hor (hor (hor ?_ ?_) ?_) ?_) ?_) ?_) ?_) ?_) ?_) ?_ <;>
    (cases f _ <;> decide)

lemma testBit_packFun (f : Fin 10 → Bool) (i : Fin 10) : (packFun f).testBit i.val = f i := by
  have hbit (b : Bool) (n k : ℕ) : (if b then 2 ^ n else 0).testBit k = (b && decide (n = k)) := by
    cases b with
    | false => simp
    | true => simp [Nat.testBit_two_pow]
  simp only [packFun, Nat.testBit_lor, hbit]
  fin_cases i <;> simp

def maskFn (m : ℕ) : Fin 10 → Bool := fun i => m.testBit i.val

lemma land_lt_of_lt {a b : ℕ} (ha : a < 1024) : (a &&& b) < 1024 :=
  Nat.lt_of_le_of_lt Nat.and_le_left ha

lemma pGraph_iff (x : Fin 10 → Bool) :
    pGraph x = true ↔
      ∃ i j : Fin 10, x i = true ∧ x j = true ∧ (pMask.getD i.val 0).testBit j.val = true := by
  unfold pGraph
  exact ⟨fun h => of_decide_eq_true h, fun h => decide_eq_true h⟩

lemma hasEdgeBit_eq_pGraph (m : ℕ) (hm : m < 1024) : hasEdgeBit m = pGraph (maskFn m) := by
  apply Bool.eq_iff_iff.mpr
  rw [pGraph_iff]
  dsimp only [hasEdgeBit, maskFn]
  simp only [List.any_eq_true, List.mem_finRange, true_and, Bool.and_eq_true]
  constructor
  · rintro ⟨i, hi, hnz⟩
    rw [nz_iff_testBit _ (land_lt_of_lt hm), List.any_eq_true] at hnz
    obtain ⟨j, _, hj⟩ := hnz
    rw [Nat.testBit_land, Bool.and_eq_true] at hj
    exact ⟨i, j, hi, hj.1, hj.2⟩
  · rintro ⟨i, j, hi, hj, hij⟩
    refine ⟨i, hi, ?_⟩
    rw [nz_iff_testBit _ (land_lt_of_lt hm), List.any_eq_true]
    refine ⟨j, List.mem_finRange j, ?_⟩
    rw [Nat.testBit_land, Bool.and_eq_true]
    exact ⟨hj, hij⟩

lemma testBit_nbrMask (s u : ℕ) (w : Fin 10) :
    (nbrMask s u).testBit w.val =
      (!s.testBit w.val && (List.finRange 10).any fun i => (u &&& s).testBit i.val && (pMask.getD i.val 0).testBit w.val) := by
  simp only [nbrMask, Nat.testBit_land, Nat.testBit_xor, testBit_foldr_lor,
    testBit_1023 w.val w.isLt, Bool.true_xor, Bool.and_comm]

lemma nbrMask_eq_pGraph (s u : ℕ) (hs : s < 1024) (hno : hasEdgeBit (u &&& s) = false) (w : Fin 10) :
    (nbrMask s u).testBit w.val =
      pGraph (fun i => if s.testBit i.val then (u &&& s).testBit i.val else decide (i = w)) := by
  have hus : u &&& s < 1024 := Nat.lt_of_le_of_lt Nat.and_le_right hs
  have hno' : pGraph (maskFn (u &&& s)) = false := by
    rw [← hasEdgeBit_eq_pGraph _ hus]
    exact hno
  rw [testBit_nbrMask]
  apply Bool.eq_iff_iff.mpr
  rw [pGraph_iff]
  simp only [Bool.and_eq_true, List.any_eq_true, List.mem_finRange, true_and]
  constructor
  · rintro ⟨hws, i, hui, hiw⟩
    have his : s.testBit i.val = true := by
      rw [Nat.testBit_land, Bool.and_eq_true] at hui
      exact hui.2
    refine ⟨i, w, ?_, ?_, hiw⟩
    · simp [his, hui]
    · simp only [Bool.not_eq_true'] at hws
      simp [hws]
  · rintro ⟨i, j, hi, hj, hij⟩
    by_cases his : s.testBit i.val = true <;> by_cases hjs : s.testBit j.val = true
    · rw [ite_eq_left his] at hi
      rw [ite_eq_left hjs] at hj
      have hbad : pGraph (maskFn (u &&& s)) = true :=
        (pGraph_iff _).mpr ⟨i, j, hi, hj, hij⟩
      exact absurd (hno'.symm.trans hbad) Bool.false_ne_true
    · rw [ite_eq_left his] at hi
      rw [ite_eq_right hjs, decide_eq_true_eq] at hj
      subst hj
      exact ⟨by simpa using hjs, i, hi, hij⟩
    · rw [ite_eq_right his, decide_eq_true_eq] at hi
      rw [ite_eq_left hjs] at hj
      subst hi
      refine ⟨by simpa using his, j, hj, ?_⟩
      rw [pMask_symm j i]
      exact hij
    · rw [ite_eq_right his, decide_eq_true_eq] at hi
      rw [ite_eq_right hjs, decide_eq_true_eq] at hj
      subst hi; subst hj
      rw [pMask_irrefl] at hij
      exact Bool.noConfusion hij

lemma nbrMask_lt (s u : ℕ) (hs : s < 1024) : nbrMask s u < 1024 := by
  have hlt : 1023 ^^^ s < 1024 := by
    have hfin : ∀ a : Fin 1024, (1023 ^^^ a.val) < 1024 := by decide +kernel
    exact hfin ⟨s, hs⟩
  exact Nat.lt_of_le_of_lt Nat.and_le_right hlt

def step (w : List Bool) (g : Gate) : List Bool :=
  w ++ [g.op.eval (g.inputs.map fun i => w.getD i false)]

def baseWires (x : Fin 10 → Bool) : List Bool :=
  List.ofFn x ++ [!x 0]

lemma baseWires_length (x : Fin 10 → Bool) : (baseWires x).length = 11 := by
  simp [baseWires]

lemma foldl_step_length (gs : List Gate) (w : List Bool) :
    (gs.foldl step w).length = w.length + gs.length := by
  induction gs generalizing w with
  | nil => simp
  | cons g gs ih =>
    rw [List.foldl_cons, ih]
    simp [step]
    omega

lemma foldl_step_kept (gs : List Gate) (w : List Bool) (k : ℕ) (hk : k < w.length) :
    (gs.foldl step w).getD k false = w.getD k false := by
  induction gs generalizing w with
  | nil => rfl
  | cons g gs ih =>
    rw [List.foldl_cons]
    have hk' : k < (step w g).length := by
      simp [step]
      omega
    rw [ih (step w g) hk']
    dsimp only [step]
    rw [List.getD_append _ _ _ _ hk]

lemma take_eq_append (gs : List Gate) (m : ℕ) (hm : m < gs.length) :
    gs.take (m + 1) = gs.take m ++ [gs.get ⟨m, hm⟩] := by
  rw [List.take_add_one, List.getElem?_eq_getElem hm, Option.toList_some]
  rfl

lemma takeVal_eq_wireVal (C : Circuit) (m : ℕ) (x : Fin 10 → Bool) (k : ℕ) (hk : k < 11 + m)
    (hm : m ≤ C.gates.length) :
    ((C.gates.take m).foldl step (baseWires x)).getD k false =
      (C.wires (baseWires x)).getD k false := by
  have hlen : k < ((C.gates.take m).foldl step (baseWires x)).length := by
    rw [foldl_step_length, baseWires_length, List.length_take_of_le hm]
    exact hk
  have hC : C.wires (baseWires x) =
      (C.gates.drop m).foldl step ((C.gates.take m).foldl step (baseWires x)) := by
    change C.gates.foldl step (baseWires x) = _
    conv_lhs => rw [← List.take_append_drop m C.gates, List.foldl_append]
  rw [hC, foldl_step_kept _ _ k hlen]

lemma inside_agree (C : Circuit) (S : Finset (Fin 10)) (A : Finset ℕ)
    (hIn : ∀ i : Fin 10, i.val ∈ A ↔ i ∈ S)
    (h10 : 10 ∈ A ↔ 0 ∈ S)
    (hCut : ∀ t : Fin C.size, ∀ w ∈ (C.gates.get t).inputs, 11 + t.val ∈ A → w ∈ A)
    (x₁ x₂ : Fin 10 → Bool) (hEq : ∀ i ∈ S, x₁ i = x₂ i) :
    ∀ m ≤ C.gates.length, ∀ k < 11 + m, k ∈ A →
      ((C.gates.take m).foldl step (baseWires x₁)).getD k false =
      ((C.gates.take m).foldl step (baseWires x₂)).getD k false := by
  intro m hm
  induction m with
  | zero =>
    intro k hk hkA
    simp only [List.take_zero, List.foldl_nil]
    by_cases hk10 : k < 10
    · have hiS : ⟨k, hk10⟩ ∈ S := (hIn ⟨k, hk10⟩).mp hkA
      simp only [baseWires]
      have hl1 : k < (List.ofFn x₁).length := by simpa using hk10
      have hl2 : k < (List.ofFn x₂).length := by simpa using hk10
      rw [List.getD_append _ _ _ _ hl1, List.getD_append _ _ _ _ hl2]
      rw [List.getD_eq_getElem _ _ hl1, List.getD_eq_getElem _ _ hl2,
          List.getElem_ofFn, List.getElem_ofFn]
      exact hEq ⟨k, hk10⟩ hiS
    · have hk_eq : k = 10 := by omega
      subst hk_eq
      have h0S : (0 : Fin 10) ∈ S := h10.mp hkA
      simp only [baseWires]
      have hge1 : (List.ofFn x₁).length ≤ 10 := by simp
      have hge2 : (List.ofFn x₂).length ≤ 10 := by simp
      rw [List.getD_append_right _ _ _ _ hge1, List.getD_append_right _ _ _ _ hge2]
      simp [hEq 0 h0S]
  | succ m ih =>
    have hm_lt : m < C.gates.length := hm
    have ih' := ih (Nat.le_of_lt hm_lt)
    intro k hk hkA
    simp only [take_eq_append C.gates m hm_lt, List.foldl_append, List.foldl_cons, List.foldl_nil]
    by_cases hkm : k < 11 + m
    · have hlen1 : k < ((C.gates.take m).foldl step (baseWires x₁)).length := by
        rw [foldl_step_length, baseWires_length, List.length_take_of_le (Nat.le_of_lt hm_lt)]
        exact hkm
      have hlen2 : k < ((C.gates.take m).foldl step (baseWires x₂)).length := by
        rw [foldl_step_length, baseWires_length, List.length_take_of_le (Nat.le_of_lt hm_lt)]
        exact hkm
      dsimp only [step]
      rw [List.getD_append _ _ _ _ hlen1, List.getD_append _ _ _ _ hlen2]
      exact ih' k hkm hkA
    · have hk_eq : k = 11 + m := by omega
      subst hk_eq
      have hlen1 : ((C.gates.take m).foldl step (baseWires x₁)).length = 11 + m := by
        rw [foldl_step_length, baseWires_length, List.length_take_of_le (Nat.le_of_lt hm_lt)]
      have hlen2 : ((C.gates.take m).foldl step (baseWires x₂)).length = 11 + m := by
        rw [foldl_step_length, baseWires_length, List.length_take_of_le (Nat.le_of_lt hm_lt)]
      dsimp only [step]
      rw [List.getD_append_right _ _ _ _ hlen1.le, List.getD_append_right _ _ _ _ hlen2.le]
      rw [hlen1, hlen2, Nat.sub_self]
      simp only [List.getD_cons_zero]
      congr 1
      apply List.map_congr_left
      intro w hw
      by_cases hw_lt : w < 11 + m
      · exact ih' w hw_lt (hCut ⟨m, hm_lt⟩ w hw hkA)
      · have hw1 : ((C.gates.take m).foldl step (baseWires x₁)).length ≤ w := by omega
        have hw2 : ((C.gates.take m).foldl step (baseWires x₂)).length ≤ w := by omega
        rw [List.getD_eq_getElem?_getD, List.getElem?_eq_none hw1]
        rw [List.getD_eq_getElem?_getD, List.getElem?_eq_none hw2]

lemma outside_agree (C : Circuit) (S : Finset (Fin 10)) (A B : Finset ℕ)
    (hIn : ∀ i : Fin 10, i.val ∈ A ↔ i ∈ S)
    (h10 : 10 ∈ A ↔ 0 ∈ S)
    (hCutB : ∀ t : Fin C.size, ∀ w ∈ (C.gates.get t).inputs, 11 + t.val ∉ A → w ∈ A → w ∈ B)
    (x₁ x₂ : Fin 10 → Bool)
    (hOutS : ∀ i ∉ S, x₁ i = x₂ i)
    (hB : ∀ w ∈ A, w ∈ B → (C.wires (baseWires x₁)).getD w false = (C.wires (baseWires x₂)).getD w false) :
    ∀ m ≤ C.gates.length, ∀ k < 11 + m, k ∉ A →
      ((C.gates.take m).foldl step (baseWires x₁)).getD k false =
      ((C.gates.take m).foldl step (baseWires x₂)).getD k false := by
  intro m hm
  induction m with
  | zero =>
    intro k hk hknA
    simp only [List.take_zero, List.foldl_nil]
    by_cases hk10 : k < 10
    · have hiS : ⟨k, hk10⟩ ∉ S := fun h => hknA ((hIn ⟨k, hk10⟩).mpr h)
      simp only [baseWires]
      have hl1 : k < (List.ofFn x₁).length := by simpa using hk10
      have hl2 : k < (List.ofFn x₂).length := by simpa using hk10
      rw [List.getD_append _ _ _ _ hl1, List.getD_append _ _ _ _ hl2]
      rw [List.getD_eq_getElem _ _ hl1, List.getD_eq_getElem _ _ hl2,
          List.getElem_ofFn, List.getElem_ofFn]
      exact hOutS ⟨k, hk10⟩ hiS
    · have hk_eq : k = 10 := by omega
      subst hk_eq
      have h0S : (0 : Fin 10) ∉ S := fun h => hknA (h10.mpr h)
      simp only [baseWires]
      have hge1 : (List.ofFn x₁).length ≤ 10 := by simp
      have hge2 : (List.ofFn x₂).length ≤ 10 := by simp
      rw [List.getD_append_right _ _ _ _ hge1, List.getD_append_right _ _ _ _ hge2]
      simp [hOutS 0 h0S]
  | succ m ih =>
    have hm_lt : m < C.gates.length := hm
    have ih' := ih (Nat.le_of_lt hm_lt)
    intro k hk hknA
    simp only [take_eq_append C.gates m hm_lt, List.foldl_append, List.foldl_cons, List.foldl_nil]
    by_cases hkm : k < 11 + m
    · have hlen1 : k < ((C.gates.take m).foldl step (baseWires x₁)).length := by
        rw [foldl_step_length, baseWires_length, List.length_take_of_le (Nat.le_of_lt hm_lt)]
        exact hkm
      have hlen2 : k < ((C.gates.take m).foldl step (baseWires x₂)).length := by
        rw [foldl_step_length, baseWires_length, List.length_take_of_le (Nat.le_of_lt hm_lt)]
        exact hkm
      dsimp only [step]
      rw [List.getD_append _ _ _ _ hlen1, List.getD_append _ _ _ _ hlen2]
      exact ih' k hkm hknA
    · have hk_eq : k = 11 + m := by omega
      subst hk_eq
      have hlen1 : ((C.gates.take m).foldl step (baseWires x₁)).length = 11 + m := by
        rw [foldl_step_length, baseWires_length, List.length_take_of_le (Nat.le_of_lt hm_lt)]
      have hlen2 : ((C.gates.take m).foldl step (baseWires x₂)).length = 11 + m := by
        rw [foldl_step_length, baseWires_length, List.length_take_of_le (Nat.le_of_lt hm_lt)]
      dsimp only [step]
      rw [List.getD_append_right _ _ _ _ hlen1.le, List.getD_append_right _ _ _ _ hlen2.le]
      rw [hlen1, hlen2, Nat.sub_self]
      simp only [List.getD_cons_zero]
      congr 1
      apply List.map_congr_left
      intro w hw
      by_cases hw_lt : w < 11 + m
      · by_cases hwA : w ∈ A
        · have hwB := hCutB ⟨m, hm_lt⟩ w hw hknA hwA
          rw [takeVal_eq_wireVal C m x₁ w hw_lt (Nat.le_of_lt hm_lt)]
          rw [takeVal_eq_wireVal C m x₂ w hw_lt (Nat.le_of_lt hm_lt)]
          exact hB w hwA hwB
        · exact ih' w hw_lt hwA
      · have hw1 : ((C.gates.take m).foldl step (baseWires x₁)).length ≤ w := by omega
        have hw2 : ((C.gates.take m).foldl step (baseWires x₂)).length ≤ w := by omega
        rw [List.getD_eq_getElem?_getD, List.getElem?_eq_none hw1]
        rw [List.getD_eq_getElem?_getD, List.getElem?_eq_none hw2]

lemma eval_agree_of_B_agree (C : Circuit) (S : Finset (Fin 10)) (A B : Finset ℕ)
    (hIn : ∀ i : Fin 10, i.val ∈ A ↔ i ∈ S)
    (h10 : 10 ∈ A ↔ 0 ∈ S)
    (hCut : ∀ t : Fin C.size, ∀ w ∈ (C.gates.get t).inputs,
      (11 + t.val ∈ A → w ∈ A) ∧ (11 + t.val ∉ A → w ∈ A → w ∈ B))
    (hOut : C.output ∈ A → C.output ∈ B)
    (u₁ u₂ y : Fin 10 → Bool)
    (hB0 : (fun w : ↥B => (C.wires (baseWires (fun i => if i ∈ S then u₁ i else false))).getD w.val false) =
           (fun w : ↥B => (C.wires (baseWires (fun i => if i ∈ S then u₂ i else false))).getD w.val false)) :
    C.eval (baseWires (fun i => if i ∈ S then u₁ i else y i)) =
    C.eval (baseWires (fun i => if i ∈ S then u₂ i else y i)) := by
  let x₁ := fun i => if i ∈ S then u₁ i else y i
  let x₂ := fun i => if i ∈ S then u₂ i else y i
  let r₁ := fun i => if i ∈ S then u₁ i else false
  let r₂ := fun i => if i ∈ S then u₂ i else false
  have hB : ∀ w ∈ A, w ∈ B → (C.wires (baseWires x₁)).getD w false = (C.wires (baseWires x₂)).getD w false := by
    intro w hwA hwB
    by_cases hlt : w < 11 + C.gates.length
    · have h1 : (C.wires (baseWires x₁)).getD w false = (C.wires (baseWires r₁)).getD w false := by
        rw [← takeVal_eq_wireVal C C.gates.length x₁ w hlt le_rfl]
        rw [← takeVal_eq_wireVal C C.gates.length r₁ w hlt le_rfl]
        exact inside_agree C S A hIn h10 (fun t wt ht => (hCut t wt ht).1) x₁ r₁
          (fun i hi => by simp [x₁, r₁, hi]) C.gates.length le_rfl w hlt hwA
      have h2 : (C.wires (baseWires x₂)).getD w false = (C.wires (baseWires r₂)).getD w false := by
        rw [← takeVal_eq_wireVal C C.gates.length x₂ w hlt le_rfl]
        rw [← takeVal_eq_wireVal C C.gates.length r₂ w hlt le_rfl]
        exact inside_agree C S A hIn h10 (fun t wt ht => (hCut t wt ht).1) x₂ r₂
          (fun i hi => by simp [x₂, r₂, hi]) C.gates.length le_rfl w hlt hwA
      have h12 := congrFun hB0 ⟨w, hwB⟩
      exact h1.trans (h12.trans h2.symm)
    · have hw1 : (C.wires (baseWires x₁)).length ≤ w := by
        change (C.gates.foldl step (baseWires x₁)).length ≤ w
        rw [foldl_step_length, baseWires_length]
        omega
      have hw2 : (C.wires (baseWires x₂)).length ≤ w := by
        change (C.gates.foldl step (baseWires x₂)).length ≤ w
        rw [foldl_step_length, baseWires_length]
        omega
      rw [List.getD_eq_getElem?_getD, List.getElem?_eq_none hw1]
      rw [List.getD_eq_getElem?_getD, List.getElem?_eq_none hw2]
  by_cases hout_lt : C.output < 11 + C.gates.length
  · by_cases houtA : C.output ∈ A
    · exact hB C.output houtA (hOut houtA)
    · change (C.wires (baseWires x₁)).getD C.output false = (C.wires (baseWires x₂)).getD C.output false
      rw [← takeVal_eq_wireVal C C.gates.length x₁ C.output hout_lt le_rfl]
      rw [← takeVal_eq_wireVal C C.gates.length x₂ C.output hout_lt le_rfl]
      exact outside_agree C S A B hIn h10 (fun t wt ht => (hCut t wt ht).2) x₁ x₂
        (fun i hi => by simp [x₁, x₂, hi]) hB C.gates.length le_rfl C.output hout_lt houtA
  · change (C.wires (baseWires x₁)).getD C.output false = (C.wires (baseWires x₂)).getD C.output false
    have hw1 : (C.wires (baseWires x₁)).length ≤ C.output := by
      change (C.gates.foldl step (baseWires x₁)).length ≤ C.output
      rw [foldl_step_length, baseWires_length]
      omega
    have hw2 : (C.wires (baseWires x₂)).length ≤ C.output := by
      change (C.gates.foldl step (baseWires x₂)).length ≤ C.output
      rw [foldl_step_length, baseWires_length]
      omega
    rw [List.getD_eq_getElem?_getD, List.getElem?_eq_none hw1]
    rw [List.getD_eq_getElem?_getD, List.getElem?_eq_none hw2]

end PEqualNP.Outside.L_meta_4083_aux

open PEqualNP.Outside.L_meta_4083_aux in
theorem PEqualNP.Outside.L_meta_4083 : ∀ (x1 : PEqualNP.CircuitLowerBounds.Circuit), (∀ (x2 : Fin (10 : ℕ) → Bool), x1.eval (List.ofFn x2 ++ [!x2 (0 : Fin (10 : ℕ))]) = (fun (x3 : Fin (10 : ℕ) → Bool) => Decidable.decide (∃ (x4 : Fin (10 : ℕ)) (x5 : Fin (10 : ℕ)), x3 x4 = Bool.true ∧ x3 x5 = Bool.true ∧ ([(50 : ℕ), (69 : ℕ), (138 : ℕ), (276 : ℕ), (521 : ℕ), (385 : ℕ), (770 : ℕ), (548 : ℕ), (104 : ℕ), (208 : ℕ)].getD ↑x4 (0 : ℕ)).testBit ↑x5 = Bool.true)) x2) → ∀ (x3 : Finset (Fin (10 : ℕ))) (x4 x5 : Finset ℕ), (∀ (x6 : Fin (10 : ℕ)), ↑x6 ∈ x4 ↔ x6 ∈ x3) → ((10 : ℕ) ∈ x4 ↔ (0 : Fin (10 : ℕ)) ∈ x3) → (∀ (x8 : Fin x1.size), ∀ x9 ∈ (x1.gates.get x8).inputs, ((11 : ℕ) + ↑x8 ∈ x4 → x9 ∈ x4) ∧ ((11 : ℕ) + ↑x8 ∉ x4 → x9 ∈ x4 → x9 ∈ x5)) → (x1.output ∈ x4 → x1.output ∈ x5) → [(1 : ℕ), (2 : ℕ), (4 : ℕ), (6 : ℕ), (9 : ℕ), (12 : ℕ), (9 : ℕ), (9 : ℕ), (5 : ℕ), (3 : ℕ), (2 : ℕ)].getD x3.card (0 : ℕ) ≤ (Finset.image (fun (x10 : Fin (10 : ℕ) → Bool) (x11 : ↥x5) => (x1.wires (List.ofFn x10 ++ [!x10 (0 : Fin (10 : ℕ))])).getD (↑x11) Bool.false) Finset.univ).card := by
  intro C hEval S A B hIn h10 hCut hOut
  have hEval' : ∀ x : Fin 10 → Bool, C.eval (baseWires x) = pGraph x := hEval
  let sMask : ℕ := packFun (fun i => decide (i ∈ S))
  have hsMask : sMask < 1024 := packFun_lt _
  have hpop : popcount10 sMask = S.card := by
    dsimp [popcount10]
    rw [List.countP_eq_length_filter]
    have hnd : ((List.finRange 10).filter fun i => sMask.testBit i.val).Nodup :=
      (List.nodup_finRange 10).filter _
    rw [← List.toFinset_card_of_nodup hnd]
    congr 1
    ext i
    simp [sMask, testBit_packFun]
  have hchk := checkAll sMask hsMask
  dsimp only [checkWith] at hchk
  rw [hpop] at hchk
  let us := unpack (targetCount.getD S.card 0) (witnessAt sMask)
  have hlen : us.length = targetCount.getD S.card 0 := unpack_length _ _
  have hnodup : (us.map (smallSigNat sMask)).Nodup := strictlyInc_nodup hchk
  let ImgB := Finset.image (fun (x10 : Fin 10 → Bool) (x11 : ↥B) =>
    (C.wires (baseWires x10)).getD x11.val false) Finset.univ
  change targetCount.getD S.card 0 ≤ ImgB.card
  rw [← hlen]
  let φ : Fin us.length → ↥ImgB := fun i =>
    let u := us.get i
    let r : Fin 10 → Bool := fun j => if j ∈ S then maskFn (u &&& sMask) j else false
    ⟨fun w => (C.wires (baseWires r)).getD w.val false,
      Finset.mem_image.mpr ⟨r, Finset.mem_univ r, rfl⟩⟩
  have hinj : Function.Injective φ := by
    intro i₁ i₂ hEq
    have hEq' : (φ i₁).val = (φ i₂).val := congrArg Subtype.val hEq
    have hSameSig : smallSigNat sMask (us.get i₁) = smallSigNat sMask (us.get i₂) := by
      have hagree : ∀ y : Fin 10 → Bool,
          pGraph (fun j => if j ∈ S then maskFn (us.get i₁ &&& sMask) j else y j) =
          pGraph (fun j => if j ∈ S then maskFn (us.get i₂ &&& sMask) j else y j) := by
        intro y
        rw [← hEval' _, ← hEval' _]
        exact eval_agree_of_B_agree C S A B hIn h10 hCut hOut
          (maskFn (us.get i₁ &&& sMask)) (maskFn (us.get i₂ &&& sMask)) y hEq'
      dsimp only [smallSigNat]
      have hus1 : us.get i₁ &&& sMask < 1024 := Nat.lt_of_le_of_lt Nat.and_le_right hsMask
      have hus2 : us.get i₂ &&& sMask < 1024 := Nat.lt_of_le_of_lt Nat.and_le_right hsMask
      have hm1 : (fun j => if j ∈ S then maskFn (us.get i₁ &&& sMask) j else false) =
                 maskFn (us.get i₁ &&& sMask) := by
        funext j
        by_cases hj : j ∈ S
        · simp [hj]
        · have hsj : sMask.testBit j.val = false := by simp [sMask, testBit_packFun, hj]
          simp [hj, maskFn, hsj]
      have hm2 : (fun j => if j ∈ S then maskFn (us.get i₂ &&& sMask) j else false) =
                 maskFn (us.get i₂ &&& sMask) := by
        funext j
        by_cases hj : j ∈ S
        · simp [hj]
        · have hsj : sMask.testBit j.val = false := by simp [sMask, testBit_packFun, hj]
          simp [hj, maskFn, hsj]
      have h0 : hasEdgeBit (us.get i₁ &&& sMask) = hasEdgeBit (us.get i₂ &&& sMask) := by
        rw [hasEdgeBit_eq_pGraph _ hus1, hasEdgeBit_eq_pGraph _ hus2, ← hm1, ← hm2]
